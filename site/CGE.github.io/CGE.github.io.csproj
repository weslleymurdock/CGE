<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CardGameEngine/CardGameEngine.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.*" />
  </ItemGroup>

  <Target Name="ValidateCardGameEngineApiDocumentation" BeforeTargets="Build">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/api/CardGameEngine.xml')" Text="CardGameEngine API XML documentation was not generated." />
  </Target>

</Project>
